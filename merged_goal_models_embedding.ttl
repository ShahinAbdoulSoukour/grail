gmb:operation_D3FEND_D3-AI a gm:D3FENDOperation,
        gm:Operation ;
    gm:description "Asset inventorying identifies and records the organization's assets and enriches each inventory item with knowledge about their vulnerabilities." ;
    gm:operationId "D3-AI" ;
    gm:operationName "Asset Inventory" ;
    gm:source "D3FEND" .

gmb:operation_D3FEND_D3-ANAA a gm:D3FENDOperation,
        gm:Operation ;
    gm:description "Detection of unauthorized use of administrative network protocols by analyzing network activity against a baseline." ;
    gm:operationId "D3-ANAA" ;
    gm:operationName "Administrative Network Activity Analysis" ;
    gm:source "D3FEND" .

gmb:operation_D3FEND_D3-CM a gm:D3FENDOperation,
        gm:Operation ;
    gm:description "Modify content that does not comply with policy." ;
    gm:operationId "D3-CM" ;
    gm:operationName "Content Modification" ;
    gm:source "D3FEND" .

gmb:operation_D3FEND_D3-DA a gm:D3FENDOperation,
        gm:Operation ;
    gm:description "Executing or opening a file in a synthetic \"sandbox\" environment to determine if the file is a malicious program or if the file exploits another program such as a document reader." ;
    gm:operationId "D3-DA" ;
    gm:operationName "Dynamic Analysis" ;
    gm:source "D3FEND" .

gmb:operation_D3FEND_D3-EDL a gm:D3FENDOperation,
        gm:Operation ;
    gm:description "Blocking the execution of files on a host in accordance with defined application policy rules." ;
    gm:operationId "D3-EDL" ;
    gm:operationName "Executable Denylisting" ;
    gm:source "D3FEND" .

gmb:operation_D3FEND_D3-FH a gm:D3FENDOperation,
        gm:Operation ;
    gm:description "Employing file hash comparisons to detect known malware." ;
    gm:operationId "D3-FH" ;
    gm:operationName "File Hashing" ;
    gm:source "D3FEND" .

gmb:operation_D3FEND_D3-LAMED a gm:D3FENDOperation,
        gm:Operation ;
    gm:description "LAN access mediation encompasses the application of strict access control policies, systematic verification of devices, and authentication mechanisms to govern connectivity to a Local Area Network." ;
    gm:operationId "D3-LAMED" ;
    gm:operationName "LAN Access Mediation" ;
    gm:source "D3FEND" .

gmb:operation_D3FEND_D3-MENCR a gm:D3FENDOperation,
        gm:Operation ;
    gm:description "Encrypting a message body using a cryptographic key." ;
    gm:operationId "D3-MENCR" ;
    gm:operationName "Message Encryption" ;
    gm:source "D3FEND" .

gmb:operation_D3FEND_D3-MH a gm:D3FENDOperation,
        gm:Operation ;
    gm:description "The application of security controls to user-to-user and system-to-system communications so messages remain confidential, unaltered, and verifiable while resisting injection, replay, and tampering." ;
    gm:operationId "D3-MH" ;
    gm:operationName "Message Hardening" ;
    gm:source "D3FEND" .

gmb:operation_D3FEND_D3-OPR a gm:D3FENDOperation,
        gm:Operation ;
    gm:description "Restricting unauthorized changes to the operating mode prevents devices from switching into inappropriate or vulnerable states during normal use." ;
    gm:operationId "D3-OPR" ;
    gm:operationName "Operating Mode Restriction" ;
    gm:source "D3FEND" .

gmb:operation_D3FEND_D3-RAM a gm:D3FENDOperation,
        gm:Operation ;
    gm:description "Routing access mediation is a network security approach that manages and controls access at the network layer using VPNs, tunneling protocols, firewall rules, and traffic inspection to ensure secure and efficient data routing." ;
    gm:operationId "D3-RAM" ;
    gm:operationName "Routing Access Mediation" ;
    gm:source "D3FEND" .

gmb:operation_D3FEND_D3-SDM a gm:D3FENDOperation,
        gm:Operation ;
    gm:description "Tracking changes to the state or configuration of critical system level processes." ;
    gm:operationId "D3-SDM" ;
    gm:operationName "System Daemon Monitoring" ;
    gm:source "D3FEND" .

gmb:operation_OntoSecAI_AML.M0013 a gm:OntoSecAIOperation,
        gm:Operation ;
    gm:description "Enforce binary and application integrity with digital signature verification to prevent untrusted code from executing. Adversaries can embed malicious code in ML software, models and Library. Enforcement of code signing can prevent the compromise of the machine learning supply chain and prevent execution of malicious code." ;
    gm:operationId "AML.M0013" ;
    gm:operationName "Code Signing" ;
    gm:source "OntoSecAI" .

gmb:operation_OntoSecAI_AML.M0035 a gm:OntoSecAIOperation,
        gm:Operation ;
    gm:description "Protect against reverse engineering by using obfuscation techniques, encryption of sensitive hardware components, and applying intellectual property protection measures to prevent the exploitation of vulnerabilities and unauthorized copying." ;
    gm:operationId "AML.M0035" ;
    gm:operationName "Protection from Reverse Engineering" ;
    gm:source "OntoSecAI" .

gmb:operation_OntoSecAI_AML.M0037 a gm:OntoSecAIOperation,
        gm:Operation ;
    gm:description "Conduct thorough risk assessments and enforce usage policies to limit the misuse of hardware functionalities, alongside implementing hardware security modules (HSMs) to ensure only intended uses of hardware features." ;
    gm:operationId "AML.M0037" ;
    gm:operationName "Hardware security modules" ;
    gm:source "OntoSecAI" .

gmb:operation_OntoSecAI_OWASP.M0017 a gm:OntoSecAIOperation,
        gm:Operation ;
    gm:description "Sign models and code, apply anomaly detection, and monitor." ;
    gm:operationId "OWASP.M0017" ;
    gm:operationName "Anomaly detection" ;
    gm:source "OntoSecAI" .

