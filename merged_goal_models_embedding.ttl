    gm:source "D3FEND" .

gmb:operation_D3FEND_D3-TL a gm:D3FENDOperation,
        gm:Operation ;
    gm:description "A trusted library is a collection of pre-verified and secure code modules or components that are used within software applications to perform specific functions. These libraries are considered reliable and have been vetted for security vulnerabilities, ensuring they do not introduce risks into the application." ;
    gm:operationId "D3-TL" ;
    gm:operationName "Trusted Library" ;
    gm:source "D3FEND" .

