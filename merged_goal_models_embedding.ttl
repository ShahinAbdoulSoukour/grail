gmb:operation_D3FEND_D3-PWA a gm:D3FENDOperation,
        gm:Operation ;
    gm:description "Password authentication is a security mechanism used to verify the identity of a user or entity attempting to access a system or resource by requiring the input of a secret string of characters, known as a password, that is associated with the user or entity." ;
    gm:operationId "D3-PWA" ;
    gm:operationName "Password Authentication" ;
    gm:source "D3FEND" .

