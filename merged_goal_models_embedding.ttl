gmb:operation_OntoSecAI_AML.M0001 a gm:OntoSecAIOperation,
        gm:Operation ;
    gm:description "Limit the public release of technical information about the machine learning stack used in an organization's products or services. Technical knowledge of how machine learning is used can be leveraged by adversaries to perform targeting and tailor attacks to the target system. Additionally, consider limiting the release of organizational information - including physical locations, researcher names, and department structures - from which technical details such as machine learning techniques, model architectures, or datasets may be inferred." ;
    gm:operationId "AML.M0001" ;
    gm:operationName "Limit Release of Public Information" ;
    gm:source "OntoSecAI" .

gmb:function_AI-RMF_MEASURE a gm:Function ;
    gm:functionName "MEASURE" ;
    gm:partOf gmb:standard_AI-RMF .

gmb:operation_D3FEND_D3-AMED a gm:D3FENDOperation,
        gm:Operation ;
    gm:description "Access mediation is the process of granting or denying specific requests to: 1) obtain and use information and related information processing services; and 2) enter specific physical facilities (e.g., Federal buildings, military establishments, border crossing entrances). Access mediation decisions should enforce least privilege by granting access for scoped durations to prevent privilege creep and, where applicable, implement just-in-time (JIT) access. Denial decisions may prevent initial access or terminate access that has already been granted, ensuring continuous enforcement of security policies." ;
    gm:operationId "D3-AMED" ;
    gm:operationName "Access Mediation" ;
    gm:source "D3FEND" .

gmb:operation_OntoSecAI_AML.M0036 a gm:OntoSecAIOperation,
        gm:Operation ;
    gm:description "Implement robust access control mechanisms, enforce the principle of least privilege, and regularly update and patch systems to close security gaps that could be exploited for privilege escalation." ;
    gm:operationId "AML.M0036" ;
    gm:operationName "Principle of least privilege" ;
    gm:source "OntoSecAI" .

gmb:operation_OntoSecAI_OWASP.M0009 a gm:OntoSecAIOperation,
        gm:Operation ;
    gm:description "Create separate models for different usecases." ;
    gm:operationId "OWASP.M0009" ;
    gm:operationName "Use-Case Specific Training" ;
    gm:source "OntoSecAI" .

gmb:operation_D3FEND_D3-NRAM a gm:D3FENDOperation,
        gm:Operation ;
    gm:description "Control of access to organizational systems and services by users or processes over a network." ;
    gm:operationId "D3-NRAM" ;
    gm:operationName "Network Resource Access Mediation" ;
    gm:source "D3FEND" .

gmb:operation_D3FEND_D3-AM a gm:D3FENDOperation,
        gm:Operation ;
    gm:description "Access modeling captures and records the access permissions granted to identities (e.g., administrators, users, groups, systems) and optionally includes details on how these identities are stored, managed, and shared across systems." ;
    gm:operationId "D3-AM" ;
    gm:operationName "Access Modeling" ;
    gm:source "D3FEND" .

