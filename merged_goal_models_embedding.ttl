gmb:operation_D3FEND_D3-OLV a gm:D3FENDOperation,
        gm:Operation ;
    gm:description "Validation of variable state in the context of the control logic of the operational application." ;
    gm:operationId "D3-OLV" ;
    gm:operationName "Operational Logic Validation" ;
    gm:source "D3FEND" .

gmb:operation_D3FEND_D3-PA a gm:D3FENDOperation,
        gm:Operation ;
    gm:description "Process Analysis consists of observing a running application process and analyzing it to watch for certain behaviors or conditions which may indicate adversary activity. Analysis can occur inside of the process or through a third-party monitoring application. Examples include monitoring system and privileged calls, monitoring process initiation chains, and memory boundary allocations." ;
    gm:operationId "D3-PA" ;
    gm:operationName "Process Analysis" ;
    gm:source "D3FEND" .

gmb:operation_D3FEND_D3-PEH a gm:D3FENDOperation,
        gm:Operation ;
    gm:description "Physical changes to a computer enclosure which reduce the ability for agents or the environment to affect the contained computer system." ;
    gm:operationId "D3-PEH" ;
    gm:operationName "Physical Enclosure Hardening" ;
    gm:source "D3FEND" .

gmb:operation_D3FEND_D3-SHN a gm:D3FENDOperation,
        gm:Operation ;
    gm:description "An environment created for the purpose of attracting attackers and eliciting their behaviors that is not connected to any production enterprise systems." ;
    gm:operationId "D3-SHN" ;
    gm:operationName "Standalone Honeynet" ;
    gm:source "D3FEND" .

gmb:operation_D3FEND_D3-SPP a gm:D3FENDOperation,
        gm:Operation ;
    gm:description "Modifying system configuration to increase password strength." ;
    gm:operationId "D3-SPP" ;
    gm:operationName "Strong Password Policy" ;
    gm:source "D3FEND" .

gmb:operation_D3FEND_D3-SYSM a gm:D3FENDOperation,
        gm:Operation ;
    gm:description "System mapping encompasses the techniques to identify the organization's systems, how they are configured and decomposed into subsystems and components, how they are dependent on one another, and where they are physically located." ;
    gm:operationId "D3-SYSM" ;
    gm:operationName "System Mapping" ;
    gm:source "D3FEND" .

gmb:operation_D3FEND_D3-TBA a gm:D3FENDOperation,
        gm:Operation ;
    gm:description "Token-based authentication is an authentication protocol where users verify their identity in exchange for a unique access token. Users can then access the website, application, or resource for the life of the token without having to re-enter their credentials." ;
    gm:operationId "D3-TBA" ;
    gm:operationName "Token-based Authentication" ;
    gm:source "D3FEND" .

gmb:operation_D3FEND_D3-WSAM a gm:D3FENDOperation,
        gm:Operation ;
    gm:description "Web session access mediation secures user sessions in web applications by employing robust authentication and integrity validation, along with adaptive threat mitigation techniques, to ensure that access to web resources is authorized and protected from session-related attacks." ;
    gm:operationId "D3-WSAM" ;
    gm:operationName "Web Session Access Mediation" ;
    gm:source "D3FEND" .

gmb:operation_OntoSecAI_AML.M0011 a gm:OntoSecAIOperation,
        gm:Operation ;
    gm:description """Prevent abuse of library loading mechanisms in the operating system and software to load untrusted code by configuring appropriate library loading mechanisms and investigating potential vulnerable software.
File formats such as pickle files that are commonly used to store machine learning models can contain exploits that allow for loading of malicious libraries.""" ;
    gm:operationId "AML.M0011" ;
    gm:operationName "Restrict Library Loading" ;
    gm:source "OntoSecAI" .

gmb:operation_OntoSecAI_AML.M0014 a gm:OntoSecAIOperation,
        gm:Operation ;
    gm:description "Verify the cryptographic checksum of all machine learning artifacts to verify that the file or repositiory was not modified by an attacker." ;
    gm:operationId "AML.M0014" ;
    gm:operationName "Verify ML Artifacts" ;
    gm:source "OntoSecAI" .

gmb:operation_OntoSecAI_AML.M0017 a gm:OntoSecAIOperation,
        gm:Operation ;
    gm:description "Deploying ML models to edge devices can increase the attack surface of the system. Consider serving models in the cloud to reduce the level of access the adversary has to the model. Also consider computing features in the cloud to prevent gray-box attacks, where an adversary has access to the model preprocessing methods." ;
    gm:operationId "AML.M0017" ;
    gm:operationName "Model Distribution Methods" ;
    gm:source "OntoSecAI" .

gmb:operation_OntoSecAI_AML.M0020 a gm:OntoSecAIOperation,
        gm:Operation ;
    gm:description "Encrypting the model’s code, training data, and other sensitive information can prevent attackers from being able to access and steal the model." ;
    gm:operationId "AML.M0020" ;
    gm:operationName "Encryption" ;
    gm:source "OntoSecAI" .

gmb:operation_OntoSecAI_AML.M0033 a gm:OntoSecAIOperation,
        gm:Operation ;
    gm:description "Implement comprehensive hardware and firmware security validation processes, including regular integrity checks and the use of cryptographic signing, to detect and prevent the insertion of malicious logic." ;
    gm:operationId "AML.M0033" ;
    gm:operationName "Malicious Logic Detection in hardware" ;
    gm:source "OntoSecAI" .

gmb:operation_OntoSecAI_AML.M0038 a gm:OntoSecAIOperation,
        gm:Operation ;
    gm:description "Secure hardware interfaces by using strong authentication methods, encryption, and interface-specific security protocols to prevent unauthorized manipulation and ensure control over AI hardware systems." ;
    gm:operationId "AML.M0038" ;
    gm:operationName "Prevent Manipulation" ;
    gm:source "OntoSecAI" .

gmb:operation_OntoSecAI_OWASP.M0004 a gm:OntoSecAIOperation,
        gm:Operation ;
    gm:description "Treat LLM as untrusted and visually highlight unreliable responses." ;
    gm:operationId "OWASP.M0004" ;
    gm:operationName "Trust Boundaries" ;
    gm:source "OntoSecAI" .

gmb:operation_OntoSecAI_OWASP.M0024 a gm:OntoSecAIOperation,
        gm:Operation ;
    gm:description "Allow only essential functions for LLM agents." ;
    gm:operationId "OWASP.M0024" ;
    gm:operationName "Limit Plugin Functions" ;
    gm:source "OntoSecAI" .

